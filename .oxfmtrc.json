{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "ignorePatterns": ["bun.lock", "dist/**"], // Add `routeTree.gen.ts` to `ignorePatterns` if using Tanstack Start
  "sortImports": {
    "groups": [
      ["builtin", "external"],
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "unknown"
    ],
    "ignoreCase": true
  }
}
